# Copy this file to .env.local and replace every value. These are fake placeholders.
# .env.local is ignored by git and must never be committed.

# Supabase project (Project Settings > API). The publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Public address of this app, used in confirmation and password-reset emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: remote execution for C, C++, Java and PHP (judge0 or piston).
# Python, JavaScript and SQL run in the browser and need nothing here.
CODE_EXECUTION_PROVIDER=judge0
CODE_EXECUTION_URL=https://your-judge0-host.example.com
CODE_EXECUTION_API_KEY=your-execution-api-key-placeholder
